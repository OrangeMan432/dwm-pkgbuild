#!/bin/sh
picom &
dunst &
xclickroot -r bash /home/orangeman/scripts/xmenu.sh &
/home/orangeman/scripts/statusbar.sh &
wmname LG3D
unclutter --timeout 1 &
feh --bg-scale /usr/share/dwm/wallpaper.jpg

WM_SWITCH="/tmp/wm-switch"

if [ ! -f "$WM_SWITCH" ]; then
    echo "dwm" > "$WM_SWITCH"
fi

while true; do
    CURRENT_WM=$(cat "$WM_SWITCH")

    case $CURRENT_WM in
        "vxwm")
            vxwm 2> ~/.vxwm.log
            ;;
        "dwm"|*)
            dwm 2> ~/.dwm.log
            ;;
    esac
done
